<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_pink_waves">

    <!-- Area com rolagem vertical -->
    <ScrollView
        android:id="@+id/scrollInicio"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/barraNavegacao"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="36dp">

            <!-- Cabecalho MeuBolso -->
            <LinearLayout
                android:id="@+id/layoutCabecalho"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Logotipo -->
                <ImageView
                    android:id="@+id/imgLogoInicio"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/logo_meubolso_icone"
                    android:contentDescription="Logo MeuBolso" />

                <!-- Nome e subtitulo -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtNomeAppInicio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MeuBolso"
                        android:textColor="@color/mb_purple_dark"
                        android:textSize="27sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtSubtituloInicio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="controle de gastos"
                        android:textColor="@color/mb_muted"
                        android:textSize="15sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Saudacao ao usuario -->
            <TextView
                android:id="@+id/txtSaudacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="32dp"
                android:text="Olá, Carlos!"
                android:textColor="@color/mb_white"
                android:textSize="30sp"
                android:textStyle="bold" />

            <!-- Mensagem de boas-vindas -->
            <TextView
                android:id="@+id/txtMensagemInicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="4dp"
                android:text="Que tal cuidar do seu futuro hoje? 💜"
                android:textColor="@color/mb_muted"
                android:textSize="17sp" />

            <!-- Cartao de Saldo Atual -->
            <LinearLayout
                android:id="@+id/cardSaldoAtual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="170dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_card_saldo"
                android:orientation="vertical"
                android:padding="22dp"
                android:elevation="3dp">

                <!-- Titulo do saldo -->
                <TextView
                    android:id="@+id/txtTituloSaldo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Saldo atual"
                    android:textColor="@color/white"
                    android:textSize="17sp" />

                <!-- Valor do saldo -->
                <TextView
                    android:id="@+id/txtValorSaldo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="R$ 0,00"
                    android:textColor="@color/white"
                    android:textSize="35sp"
                    android:textStyle="bold" />

                <!-- Mensagem complementar -->
                <TextView
                    android:id="@+id/txtDescricaoSaldo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Seus ganhos e gastos em dia 🌱"
                    android:textColor="#F0EAFB"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Area de Receitas e Despesas -->
            <LinearLayout
                android:id="@+id/layoutResumoFinanceiro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <!-- Cartao de Receitas -->
                <LinearLayout
                    android:id="@+id/cardReceitas"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="138dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_card_receitas"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Titulo Receitas -->
                    <TextView
                        android:id="@+id/txtTituloReceitas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="↑ Receitas"
                        android:textColor="@color/mb_green"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Valor das Receitas -->
                    <TextView
                        android:id="@+id/txtValorReceitas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="R$ 0,00"
                        android:textColor="@color/mb_green"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- Periodo -->
                    <TextView
                        android:id="@+id/txtPeriodoReceitas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Este mês"
                        android:textColor="@color/mb_muted"
                        android:textSize="13sp" />

                </LinearLayout>

                <!-- Cartao de Despesas -->
                <LinearLayout
                    android:id="@+id/cardDespesas"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="138dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_card_despesas"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Titulo Despesas -->
                    <TextView
                        android:id="@+id/txtTituloDespesas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="↓ Despesas"
                        android:textColor="@color/mb_red"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Valor das Despesas -->
                    <TextView
                        android:id="@+id/txtValorDespesas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="R$ 0,00"
                        android:textColor="@color/mb_red"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- Periodo -->
                    <TextView
                        android:id="@+id/txtPeriodoDespesas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Este mês"
                        android:textColor="@color/mb_muted"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Cartao Resumo do Mes -->
            <LinearLayout
                android:id="@+id/cardResumoMes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="210dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card_resumo"
                android:orientation="vertical"
                android:padding="20dp"
                android:elevation="2dp">

                <!-- Titulo do resumo -->
                <TextView
                    android:id="@+id/txtTituloResumo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Resumo do mês"
                    android:textColor="@color/mb_purple_dark"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- Subtitulo -->
                <TextView
                    android:id="@+id/txtSubtituloResumo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Visão geral das suas finanças"
                    android:textColor="@color/mb_muted"
                    android:textSize="14sp" />


                <!-- Grafico e legenda do Resumo do Mes -->
                <LinearLayout
                    android:id="@+id/layoutGraficoLegenda"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Grafico circular -->
                    <FrameLayout
                        android:id="@+id/graficoResumo"
                        android:layout_width="0dp"
                        android:layout_height="160dp"
                        android:layout_weight="1"
                        android:contentDescription="Gráfico de despesas do mês" />

                    <!-- Legenda financeira -->
                    <LinearLayout
                        android:id="@+id/layoutLegendaResumo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <!-- Despesas -->
                        <TextView
                            android:id="@+id/txtLegendaDespesas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="● Despesas"
                            android:textColor="@color/mb_red"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtResumoDespesas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="R$ 0,00"
                            android:textColor="@color/mb_ink"
                            android:textSize="15sp" />

                        <!-- Saldo restante -->
                        <TextView
                            android:id="@+id/txtLegendaSaldo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:text="● Saldo restante"
                            android:textColor="@color/mb_purple"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtResumoSaldo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="R$ 0,00"
                            android:textColor="@color/mb_ink"
                            android:textSize="15sp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
            <!-- Cartao Ultimas Movimentacoes -->
            <LinearLayout
                android:id="@+id/cardUltimasMovimentacoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card_resumo"
                android:orientation="vertical"
                android:padding="20dp"
                android:elevation="2dp">

                <!-- Cabecalho da secao -->
                <LinearLayout
                    android:id="@+id/layoutCabecalhoMovimentacoes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Titulo -->
                    <TextView
                        android:id="@+id/txtTituloMovimentacoes"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Últimas movimentações"
                        android:textColor="@color/mb_purple_dark"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- Ver todas -->
                    <TextView
                        android:id="@+id/txtVerTodas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Ver todas ›"
                        android:textColor="@color/mb_purple"
                        android:textSize="14sp" />

                </LinearLayout>

                <!-- Lista com as ultimas movimentacoes reais do SQLite -->
                <LinearLayout
                    android:id="@+id/listaUltimasMovimentacoes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Barra de navegacao inferior -->
    <LinearLayout
        android:id="@+id/barraNavegacao"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:background="@drawable/bg_barra_navegacao"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="10dp"
        android:paddingBottom="6dp"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Navegacao: Inicio -->
        <LinearLayout
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Icone de casa -->
            <ImageView
                android:id="@+id/imgNavInicio"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_nav_inicio"
                android:tint="@color/mb_purple_dark"
                android:contentDescription="Início" />

            <!-- Nome da opcao -->
            <TextView
                android:id="@+id/txtNavInicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Início"
                android:textColor="@color/mb_purple_dark"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Navegacao: Historico -->
        <LinearLayout
            android:id="@+id/navHistorico"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Icone de Historico -->
            <ImageView
                android:id="@+id/imgNavHistorico"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_nav_historico"
                android:tint="@color/mb_muted"
                android:contentDescription="Histórico" />

            <!-- Nome da opcao -->
            <TextView
                android:id="@+id/txtNavHistorico"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Histórico"
                android:textColor="@color/mb_muted"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Navegacao: Nova Movimentacao -->
        <LinearLayout
            android:id="@+id/navNova"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Icone de adicionar -->
            <ImageView
                android:id="@+id/imgNavNova"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_nav_nova"
                android:tint="@color/mb_purple"
                android:contentDescription="Nova movimentação" />

            <!-- Nome da opcao -->
            <TextView
                android:id="@+id/txtNavNova"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Nova"
                android:textColor="@color/mb_purple"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Navegacao: Categorias -->
        <LinearLayout
            android:id="@+id/navCategorias"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Icone de Categorias -->
            <ImageView
                android:id="@+id/imgNavCategorias"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_nav_categorias"
                android:tint="@color/mb_muted"
                android:contentDescription="Categorias" />

            <!-- Nome da opcao -->
            <TextView
                android:id="@+id/txtNavCategorias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Categorias"
                android:textColor="@color/mb_muted"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Navegacao: Perfil -->
        <LinearLayout
            android:id="@+id/navPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Icone de Perfil -->
            <ImageView
                android:id="@+id/imgNavPerfil"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_nav_perfil"
                android:tint="@color/mb_muted"
                android:contentDescription="Perfil" />

            <!-- Nome da opcao -->
            <TextView
                android:id="@+id/txtNavPerfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Perfil"
                android:textColor="@color/mb_muted"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
