<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_pink_waves">

    <!-- Tela rolavel. A imagem de referencia nao possui menu inferior nesta tela. -->
    <ScrollView
        android:id="@+id/scrollNovaMovimentacao"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/conteudoNovaMovimentacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="20dp"
            android:paddingBottom="30dp">

            <!-- Voltar, logotipo e identificacao do aplicativo -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="76dp">

                <TextView
                    android:id="@+id/btnVoltarMovimentacao"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="@drawable/bg_card_resumo"
                    android:gravity="center"
                    android:text="←"
                    android:textColor="@color/mb_purple_dark"
                    android:textSize="27sp"
                    android:contentDescription="Voltar" />

                <ImageView
                    android:id="@+id/imgLogoNovaMovimentacao"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_gravity="center"
                    android:src="@drawable/logo_meubolso_icone"
                    android:contentDescription="MeuBolso" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:gravity="center"
                android:text="MeuBolso"
                android:textColor="@color/mb_purple_dark"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="controle de gastos"
                android:textColor="@color/mb_muted"
                android:textSize="13sp" />

            <!-- Titulo da tela -->
            <TextView
                android:id="@+id/txtTituloNovaMovimentacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:text="Nova movimentação"
                android:textColor="@color/mb_purple_dark"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center"
                android:text="Registre uma nova entrada ou saída"
                android:textColor="@color/mb_muted"
                android:textSize="14sp" />

            <!-- Alternador de tipo: inicialmente Despesa -->
            <LinearLayout
                android:id="@+id/grupoTipoMovimentacao"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card_resumo"
                android:padding="3dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/btnDespesa"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_saldo"
                    android:gravity="center"
                    android:text="⊖  Despesa"
                    android:textColor="@color/mb_white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnReceita"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="⊕  Receita"
                    android:textColor="@color/mb_purple_dark"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- VALOR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_resumo"
                android:padding="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Valor"
                    android:textSize="14sp"
                    android:textColor="@color/mb_purple_dark" />

                <EditText
                    android:id="@+id/edtValorMovimentacao"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_card_resumo"
                    android:backgroundTint="#F1EBF8"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:hint="R$ 0,00"
                    android:textColorHint="@color/mb_muted"
                    android:textColor="@color/mb_ink"
                    android:textSize="17sp"
                    android:inputType="number"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- CATEGORIA -->
            <LinearLayout
                android:id="@+id/cardCategoriaMovimentacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_resumo"
                android:padding="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Categoria"
                    android:textSize="14sp"
                    android:textColor="@color/mb_purple_dark" />

                <LinearLayout
                    android:id="@+id/campoCategoria"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_card_resumo"
                    android:backgroundTint="#F1EBF8"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Icone da categoria escolhida -->
                    <FrameLayout
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_card_despesas">

                        <ImageView
                            android:id="@+id/imgCategoriaSelecionada"
                            android:layout_width="23dp"
                            android:layout_height="23dp"
                            android:layout_gravity="center"
                            android:contentDescription="Ícone da categoria"
                            android:src="@drawable/ic_cat_outros"
                            android:tint="@color/mb_purple_dark"
                            android:visibility="gone" />

                        <!-- Moradia preserva o simbolo original -->
                        <TextView
                            android:id="@+id/txtIconeMoradia"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="⌂"
                            android:textColor="@color/mb_purple_dark"
                            android:textSize="23sp"
                            android:visibility="gone" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/txtCategoriaSelecionada"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="9dp"
                        android:text="Selecione uma categoria"
                        android:textColor="@color/mb_ink"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⌄"
                        android:textColor="@color/mb_purple_dark"
                        android:textSize="25sp" />
                </LinearLayout>

                <!-- Grade dinamica: Despesa e Receita tem categorias diferentes. -->
                <LinearLayout
                    android:id="@+id/gradeCategorias"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:orientation="vertical" />

            </LinearLayout>

            <!-- DATA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_resumo"
                android:padding="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Data"
                    android:textSize="14sp"
                    android:textColor="@color/mb_purple_dark" />

                <LinearLayout
                    android:id="@+id/btnSelecionarData"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_card_resumo"
                    android:backgroundTint="#F1EBF8"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:text="📅"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/txtDataMovimentacao"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="7dp"
                        android:text="03/05/2024"
                        android:textColor="@color/mb_ink"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⌄"
                        android:textColor="@color/mb_purple_dark"
                        android:textSize="25sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- DESCRICAO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_resumo"
                android:padding="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Descrição"
                    android:textSize="14sp"
                    android:textColor="@color/mb_purple_dark" />

                <EditText
                    android:id="@+id/edtDescricaoMovimentacao"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_card_resumo"
                    android:backgroundTint="#F1EBF8"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:hint="Ex.: Almoço no restaurante"
                    android:textColorHint="@color/mb_muted"
                    android:textColor="@color/mb_ink"
                    android:textSize="14sp"
                    android:inputType="textCapSentences"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- Acao principal e cancelamento (programaremos os cliques depois). -->
            <TextView
                android:id="@+id/btnSalvarMovimentacao"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginStart="22dp"
                android:layout_marginEnd="22dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card_resumo"
                android:gravity="center"
                android:text="Salvar movimentação"
                android:textColor="@color/mb_ink"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btnCancelar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:gravity="center"
                android:text="Cancelar"
                android:textColor="@color/mb_purple_dark"
                android:textSize="15sp" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>