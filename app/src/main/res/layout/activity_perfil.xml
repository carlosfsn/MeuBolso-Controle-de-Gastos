<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_pink_waves">

    <ScrollView
        android:id="@+id/scrollPerfil"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="false"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/barraNavegacao"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="28dp"
            android:orientation="vertical">

            <!-- Logo e identificacao -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:src="@drawable/logo_meubolso_icone"
                    android:contentDescription="MeuBolso" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MeuBolso"
                        android:textColor="@color/mb_purple_dark"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="controle de gastos"
                        android:textColor="@color/mb_muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnSinoPerfil"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:padding="11dp"
                    android:background="@drawable/bg_perfil_opcao"
                    android:src="@drawable/ic_perfil_sino"
                    android:contentDescription="Notificações" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="19dp"
                android:text="Perfil"
                android:textColor="@color/mb_purple_dark"
                android:textSize="31sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Seus dados e preferências 💜"
                android:textColor="@color/mb_muted"
                android:textSize="16sp" />

            <!-- Avatar ilustrativo padrao; nao e uma foto do usuario -->
            <FrameLayout
                android:layout_width="136dp"
                android:layout_height="136dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp">

                <ImageView
                    android:id="@+id/imgAvatarPerfil"
                    android:layout_width="122dp"
                    android:layout_height="122dp"
                    android:layout_gravity="top|center_horizontal"
                    android:src="@drawable/ic_perfil_avatar"
                    android:contentDescription="Avatar ilustrativo" />

                <ImageView
                    android:id="@+id/btnEditarAvatar"
                    android:layout_width="39dp"
                    android:layout_height="39dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_card_saldo"
                    android:padding="9dp"
                    android:src="@drawable/ic_perfil_editar_branco"
                    android:contentDescription="Editar dados do perfil" />
            </FrameLayout>

            <TextView
                android:id="@+id/txtNomePerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="1dp"
                android:text="Usuário MeuBolso"
                android:textColor="@color/mb_purple_dark"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtEmailPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="1dp"
                android:text="E-mail não configurado"
                android:textColor="@color/mb_muted"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/cardPlanoPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_card_saldo"
                android:padding="19dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:padding="12dp"
                    android:background="@drawable/bg_perfil_icone_claro"
                    android:src="@drawable/ic_perfil_coroa"
                    android:contentDescription="Versão padrão" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Versão atual"
                        android:textSize="14sp"
                        android:textColor="#E9DFFF" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Padrão"
                        android:textSize="23sp"
                        android:textStyle="bold"
                        android:textColor="@color/mb_white" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dados armazenados neste aparelho"
                        android:textSize="12sp"
                        android:textColor="#F3E9FF" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/mb_white"
                    android:textSize="31sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/opcaoEditarPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="76dp"
                android:layout_marginTop="10dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="11dp"
                android:paddingBottom="11dp"
                android:background="@drawable/bg_perfil_opcao"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="11dp"
                    android:background="@drawable/bg_perfil_icone_lilas"
                    android:src="@drawable/ic_perfil_usuario"
                    android:contentDescription="Editar perfil" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Editar perfil"
                        android:textColor="@color/mb_purple_dark"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Altere seu nome e e-mail"
                        android:textColor="@color/mb_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="28sp"
                    android:textColor="@color/mb_muted" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/opcaoMetaGastos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="76dp"
                android:layout_marginTop="10dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="11dp"
                android:paddingBottom="11dp"
                android:background="@drawable/bg_perfil_opcao"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="11dp"
                    android:background="@drawable/bg_perfil_icone_rosa"
                    android:src="@drawable/ic_perfil_meta"
                    android:contentDescription="Meta de gastos" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Meta de gastos"
                        android:textColor="@color/mb_purple_dark"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Defina seus objetivos financeiros"
                        android:textColor="@color/mb_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="28sp"
                    android:textColor="@color/mb_muted" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/opcaoNotificacoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="76dp"
                android:layout_marginTop="10dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="11dp"
                android:paddingBottom="11dp"
                android:background="@drawable/bg_perfil_opcao"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="11dp"
                    android:background="@drawable/bg_perfil_icone_verde"
                    android:src="@drawable/ic_perfil_sino"
                    android:contentDescription="Notificações" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Notificações"
                        android:textColor="@color/mb_purple_dark"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Gerencie seus alertas"
                        android:textColor="@color/mb_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="28sp"
                    android:textColor="@color/mb_muted" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/opcaoSeguranca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="76dp"
                android:layout_marginTop="10dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="11dp"
                android:paddingBottom="11dp"
                android:background="@drawable/bg_perfil_opcao"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="11dp"
                    android:background="@drawable/bg_perfil_icone_lilas"
                    android:src="@drawable/ic_perfil_escudo"
                    android:contentDescription="Segurança" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Segurança"
                        android:textColor="@color/mb_purple_dark"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Senha, privacidade e conta"
                        android:textColor="@color/mb_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="28sp"
                    android:textColor="@color/mb_muted" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/opcaoAjuda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="76dp"
                android:layout_marginTop="10dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="11dp"
                android:paddingBottom="11dp"
                android:background="@drawable/bg_perfil_opcao"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="11dp"
                    android:background="@drawable/bg_perfil_icone_rosa"
                    android:src="@drawable/ic_perfil_ajuda"
                    android:contentDescription="Ajuda" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ajuda"
                        android:textColor="@color/mb_purple_dark"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Dúvidas e suporte"
                        android:textColor="@color/mb_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="28sp"
                    android:textColor="@color/mb_muted" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/btnSairPerfil"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_perfil_opcao"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_perfil_sair"
                    android:contentDescription="Voltar ao login" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Sair da conta"
                    android:textColor="#D83D65"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Barra de navegacao inferior -->
    <LinearLayout
        android:id="@+id/barraNavegacao"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:background="@drawable/bg_barra_navegacao"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="10dp"
        android:paddingBottom="6dp"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Navegacao: Inicio -->
        <LinearLayout
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Icone de casa -->
            <ImageView
                android:id="@+id/imgNavInicio"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_nav_inicio"
                android:tint="@color/mb_muted"
                android:contentDescription="Início" />

            <!-- Nome da opcao -->
            <TextView
                android:id="@+id/txtNavInicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Início"
                android:textColor="@color/mb_muted"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Navegacao: Historico -->
        <LinearLayout
            android:id="@+id/navHistorico"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Icone de Historico -->
            <ImageView
                android:id="@+id/imgNavHistorico"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_nav_historico"
                android:tint="@color/mb_muted"
                android:contentDescription="Histórico" />

            <!-- Nome da opcao -->
            <TextView
                android:id="@+id/txtNavHistorico"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Histórico"
                android:textColor="@color/mb_muted"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Navegacao: Nova Movimentacao -->
        <LinearLayout
            android:id="@+id/navNova"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Icone de adicionar -->
            <ImageView
                android:id="@+id/imgNavNova"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_nav_nova"
                android:tint="@color/mb_purple"
                android:contentDescription="Nova movimentação" />

            <!-- Nome da opcao -->
            <TextView
                android:id="@+id/txtNavNova"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Nova"
                android:textColor="@color/mb_purple"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Navegacao: Categorias -->
        <LinearLayout
            android:id="@+id/navCategorias"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Icone de Categorias -->
            <ImageView
                android:id="@+id/imgNavCategorias"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_nav_categorias"
                android:tint="@color/mb_muted"
                android:contentDescription="Categorias" />

            <!-- Nome da opcao -->
            <TextView
                android:id="@+id/txtNavCategorias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Categorias"
                android:textColor="@color/mb_muted"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Navegacao: Perfil -->
        <LinearLayout
            android:id="@+id/navPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Icone de Perfil -->
            <ImageView
                android:id="@+id/imgNavPerfil"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_nav_perfil"
                android:tint="@color/mb_purple_dark"
                android:contentDescription="Perfil" />

            <!-- Nome da opcao -->
            <TextView
                android:id="@+id/txtNavPerfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Perfil"
                android:textColor="@color/mb_purple_dark"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>