
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Cor de fundo do campo -->
    <solid android:color="#FFF9FC" />

    <!-- Cantos arredondados -->
    <corners android:radius="16dp" />

    <!-- Borda suave -->
    <stroke
        android:width="1dp"
        android:color="#E0C3E9" />

    <!-- Espacamento interno -->
    <padding
        android:left="16dp"
        android:top="12dp"
        android:right="16dp"
        android:bottom="12dp" />

</shape>
